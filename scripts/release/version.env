# WING-026: the private-beta release version. Read by scripts/release/version.sh and
# scripts/release/build.sh; change it only with `scripts/release/version.sh bump ...`.
#   WINGMAN_RELEASE_VERSION       backend image tag prefix and Android versionName (X.Y.Z-beta.N)
#   WINGMAN_RELEASE_VERSION_CODE  Android versionCode; +1 on every bump, never reused.
#     (android/app/build.gradle.kts keeps versionCode 1 / versionName 0.1.0 for dev builds,
#     so beta builds start at 2 and always install over a dev build.)
WINGMAN_RELEASE_VERSION=0.1.0-beta.1
WINGMAN_RELEASE_VERSION_CODE=2
