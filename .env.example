# Copy to .env (git-ignored). Every value here is a safe local default.
WINGMAN_ENV=dev
WINGMAN_DATABASE_URL=postgresql+asyncpg://wingman:wingman@localhost:5432/wingman
WINGMAN_REDIS_URL=redis://localhost:6379/0
# mock = deterministic responses, no API key needed. Real providers arrive in WING-005.
WINGMAN_LLM_PROVIDER=mock
WINGMAN_LOG_LEVEL=INFO

# LLM provider settings (WING-005). Only read when WINGMAN_LLM_PROVIDER is not "mock".
# WINGMAN_LLM_API_KEY=            # never commit a real key
# WINGMAN_LLM_BASE_URL=https://api.openai.com/v1
# WINGMAN_LLM_MODEL=
# WINGMAN_LLM_TIMEOUT_S=30
# WINGMAN_LLM_MAX_ATTEMPTS=3
# WINGMAN_LLM_MAX_OUTPUT_RETRIES=1
# WINGMAN_LLM_BACKOFF_BASE_S=0.5
# WINGMAN_LLM_BACKOFF_MAX_S=8
# WINGMAN_LLM_STRICT_JSON_SCHEMA=false
# WINGMAN_LLM_INPUT_USD_PER_1M=
# WINGMAN_LLM_OUTPUT_USD_PER_1M=

# Auth (WING-004). Set all three for a real OIDC IdP, or none (then every call is 401).
# WINGMAN_AUTH_ISSUER=https://your-idp.example/
# WINGMAN_AUTH_AUDIENCE=wingman-api
# WINGMAN_AUTH_JWKS_URL=https://your-idp.example/.well-known/jwks.json
# WINGMAN_AUTH_ALGORITHMS=RS256,ES256
# WINGMAN_AUTH_LEEWAY_S=30
# DEV-ONLY stub: works only with WINGMAN_ENV=dev/test; with prod the app refuses to start.
# WINGMAN_AUTH_DEV_STUB_ENABLED=false
# WINGMAN_AUTH_DEV_SECRET=            # >= 32 chars, local only, never commit

# Tests: point DB tests at an existing Postgres instead of a throwaway cluster (WING-003).
# WINGMAN_TEST_DATABASE_URL=postgresql+asyncpg://wingman:wingman@localhost:5432/wingman_test
