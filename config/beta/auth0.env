# Wingman private beta: backend Auth0 sign-in settings (I-014).
#
# These are PUBLIC identifiers, NOT secrets: the issuer, API audience and JWKS URL are published
# by Auth0 to anyone (https://<tenant>/.well-known/openid-configuration). There is no client
# secret anywhere in Wingman's sign-in (the Android app is a public Native client using PKCE).
#
# Use: copy these four lines into backend/.env (or the deployment's env store), or run
#   scripts/configure-auth0.sh --write --beta
# The backend does NOT read this file by itself; dev, test and CI stay on the dev-token path.
#
# To change the tenant: edit this file AND config/beta/auth0.gradle.properties together (the
# issuer and audience must match), then follow docs/auth0.md ("Wingman beta tenant").
# backend/tests/test_beta_auth0_config.py checks the two files agree.
WINGMAN_AUTH_ISSUER=https://dev-zumw4z1t7m8hefst.us.auth0.com/
WINGMAN_AUTH_AUDIENCE=https://api.wingman.app
WINGMAN_AUTH_JWKS_URL=https://dev-zumw4z1t7m8hefst.us.auth0.com/.well-known/jwks.json
WINGMAN_AUTH_ALGORITHMS=RS256
