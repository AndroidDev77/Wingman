# SAMPLE configuration for infra/azure/deploy.sh. UNVERIFIED: never run against Azure.
# Names and non-secret settings only. Secrets are generated into Key Vault by the
# script or set there by hand (docs/deployment.md); they never go in this file.
#
#   cp infra/azure/sample.env ~/wingman-staging.env   # keep your copy out of the repo
#   set -a; source ~/wingman-staging.env; set +a
#   infra/azure/deploy.sh all
#
# Names marked "globally unique" must be changed to something of your own.
AZ_SUBSCRIPTION=""                      # az account list -o table
AZ_LOCATION="eastus"
AZ_RESOURCE_GROUP="rg-wingman-staging"
AZ_ACR_NAME="wingmanstagingacr"         # globally unique, 5-50 lowercase alphanumerics
AZ_KEYVAULT_NAME="kv-wingman-staging"   # globally unique, 3-24 chars
AZ_PG_SERVER="pg-wingman-staging"       # globally unique
AZ_PG_ADMIN_USER="wingmanadmin"
AZ_PG_DATABASE="wingman"
AZ_PG_SKU="Standard_B1ms"               # Burstable: fine for staging, not production
AZ_PG_TIER="Burstable"
AZ_CA_ENV="cae-wingman-staging"
AZ_APP_NAME="wingman-api"
AZ_MIGRATE_JOB="wingman-migrate"
AZ_IDENTITY_NAME="id-wingman-staging"
# Image tag to build and deploy. Defaults to the current git commit if empty.
IMAGE_TAG=""

# Non-secret app settings, passed as plain environment variables.
WINGMAN_ENV="prod"
WINGMAN_LLM_PROVIDER="mock"             # "openai" only after the wingman-llm-api-key secret exists
WINGMAN_LOG_LEVEL="INFO"
