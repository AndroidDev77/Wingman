<?xml version="1.0" encoding="utf-8"?>
<!-- Integrator-owned (D-003). Feature tickets request permission/component changes in their handoff. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- WING-016 SMS connector (docs/integrations/android_sms.md §3). Device behaviour UNVERIFIED. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Held by default SMS apps; UNVERIFIED whether the role needs it on every OEM. -->
    <uses-permission android:name="android.permission.RECEIVE_MMS" />

    <!-- WING-017: read signing certificates of the dating apps for authenticity checks
         (package visibility, API 30+). Package names UNVERIFIED until the device run. -->
    <queries>
        <package android:name="com.tinder" />
        <package android:name="com.bumble.app" />
        <package android:name="co.hinge.app" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WING-016: default-SMS-app role components (all four are required to qualify). -->
        <receiver
            android:name=".integrations.sms.android.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".integrations.sms.android.MmsWapPushDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <service
            android:name=".integrations.sms.android.RespondViaMessageService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <activity
            android:name=".integrations.sms.android.ComposeSmsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <!-- WING-016: per-part sent/delivered results from our own PendingIntents. NOT exported. -->
        <receiver
            android:name=".integrations.sms.android.SmsResultReceiver"
            android:exported="false" />

        <!-- WING-017: notification listener. Bound by the system only after the user grants
             notification access. Ignores every package outside the plugin allowlist (the Tinder,
             Bumble and Hinge plugins, WING-027..029). Device behaviour UNVERIFIED (I-003). -->
        <service
            android:name=".integrations.notifications.android.WingmanNotificationListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- WING-017: notification-access explainer (and, on debug builds only, the redacted
             inspector toggle). Exported so the device test can open it with `adb shell am start`;
             it only shows text and a button to the system settings. -->
        <activity
            android:name=".integrations.notifications.android.NotificationAccessActivity"
            android:exported="true"
            android:label="Notification access" />

        <!-- WING-029 (D-021, D-023, D-026): opt-in screen of the experimental Hinge connector. Not
             exported: reached only from Settings, where the row is shown only when
             HingeModule.connector() != null (experimental build with the client identity). In
             every other build it shows one line ("not part of this build") and does nothing. -->
        <activity
            android:name=".integrations.hinge.android.HingeExperimentalActivity"
            android:exported="false"
            android:label="Hinge (experimental)" />
    </application>
</manifest>
